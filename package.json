{
  "name": "nummo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "EXPO_PUBLIC_NUMMO_BACKEND=emulator expo start --web --host localhost",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "dev:emulator": "EXPO_PUBLIC_NUMMO_BACKEND=emulator expo start --web --host localhost",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-nummo --import emulator-seed",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-nummo --import emulator-seed \"node tests/emulator/firestore.e2e.ts\"",
    "dev:firebase": "EXPO_PUBLIC_NUMMO_BACKEND=firebase EXPO_PUBLIC_FIRESTORE_EMULATOR=127.0.0.1:8180 expo start --web --host localhost",
    "emulators:real": "firebase emulators:start --project real --only firestore --import emulator-data --export-on-exit",
    "emulators:seed": "node scripts/seed-demo.ts",
    "dev:cloud": "EXPO_PUBLIC_NUMMO_BACKEND=firebase expo start --web --host localhost",
    "emulators:seed:owner": "node scripts/seed-owner.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "expo": "~58.0.22",
    "firebase": "^13.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-paper": "5.15.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "~19.3.0",
    "firebase-tools": "^15.34.2",
    "typescript": "~6.0.3"
  }
}
