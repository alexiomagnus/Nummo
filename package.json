{
  "name": "nummo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "npm run check:env && node scripts/dev-hybrid.ts",
    "check:env": "node scripts/check-dev-env.ts",
    "check:hybrid": "node scripts/check-hybrid.ts",
    "build:cloud": "node scripts/build-cloud.ts",
    "build:demo": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_NUMMO_BACKEND=emulator expo export --platform web --output-dir dist-demo",
    "preview:cloud": "expo serve dist",
    "deploy:hosting": "node scripts/deploy-hosting.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build:demo",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-nummo --import emulator-seed \"node tests/emulator/firestore.e2e.ts\"",
    "test:hybrid": "node --test tests/integration/hybrid.e2e.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-nummo --import emulator-seed",
    "emulators:real": "firebase emulators:start --project real --only firestore --import emulator-data --export-on-exit",
    "emulators:personal": "firebase emulators:start --only firestore --import emulator-data --export-on-exit",
    "emulators:seed": "node scripts/seed-demo.ts",
    "emulators:seed:owner": "node scripts/seed-owner.ts",
    "dev:demo": "npm run check:env && EXPO_PUBLIC_NUMMO_BACKEND=emulator expo start --web --host localhost",
    "push:local": "node push-service/local.ts",
    "push:keys": "node push-service/keys.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "expo": "~58.0.22",
    "firebase": "^13.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-paper": "5.15.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "~19.3.0",
    "firebase-tools": "^15.34.2",
    "typescript": "~6.0.3"
  }
}
