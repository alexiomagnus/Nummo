# Copia in .env.local (ignorato da Git) e compila con la configurazione web del progetto
# Firebase (Console → Impostazioni progetto → Le tue app). Sono identificativi pubblici,
# non segreti: finiscono comunque nel bundle web. Usati solo da `npm run dev:firebase`.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Modalità Firebase personale; `npm run dev` forza sempre la demo sicura.
# Per il cloud impostare esplicitamente queste opzioni e seguire docs/firebase-personale.md.
# EXPO_PUBLIC_NUMMO_BACKEND=firebase
# Auth reale + Firestore locale (nessuna scrittura cloud):
# EXPO_PUBLIC_FIRESTORE_EMULATOR=127.0.0.1:8180
# Solo dispositivi fidati; la cache SDK contiene dati personali anche dopo il logout.
# Valore assente = cache in memoria. Persistenza del database gestita solo dall’SDK.
# EXPO_PUBLIC_FIRESTORE_CACHE=persistent
# Porte alternative per la sola modalità demo:
# EXPO_PUBLIC_AUTH_EMULATOR=127.0.0.1:9199
