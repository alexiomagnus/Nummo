rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Provision ONLY through Console/Admin. A client cannot appoint an owner.
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && get(/databases/$(database)/documents/config/owner).data.uid == uid;
    }
    function uuid(id) {
      return id is string && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}');
    }
    function nameKey(label) { return 'n-' + label.lower().replace('%', '%25').replace('/', '%2F'); }
    function validDate(value) {
      let parts = value.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let date = timestamp.date(year, month, day);
      // Rome switches at 01:00 UTC on the last Sunday of March/October.
      let marchEnd = timestamp.date(request.time.year(), 3, 31);
      let octoberEnd = timestamp.date(request.time.year(), 10, 31);
      let summerStart = marchEnd - duration.value(marchEnd.dayOfWeek() - 1, 'd') + duration.value(1, 'h');
      let summerEnd = octoberEnd - duration.value(octoberEnd.dayOfWeek() - 1, 'd') + duration.value(1, 'h');
      return value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && year >= 2000
        && date.year() == year && date.month() == month && date.day() == day
        && date <= request.time + duration.value(request.time >= summerStart && request.time < summerEnd ? 2 : 1, 'h');
    }
    // Price schedule of a series (mirrors src/domain/pricing.ts): at most 8 changes (more exceed the 1000-expression limit), each
    // {index 1..999, amount_minor, once}. Rules have no loops, so the list is checked by position.
    // Exactly these three keys (hasOnly + size). A non-map entry makes keys() fail, which denies the write.
    function priceChange(c) {
      return c.keys().hasOnly(['index', 'amount_minor', 'once']) && c.size() == 3
        && c.index is int && c.index >= 1 && c.index <= 999
        && c.amount_minor is int && c.amount_minor > 0 && c.amount_minor <= 9999999 && c.once is bool;
    }
    function changeAt(l, i) { return l.size() <= i || priceChange(l[i]); }
    function priceChanges(l) {
      return l is list && l.size() <= 8
        && changeAt(l, 0)
        && changeAt(l, 1)
        && changeAt(l, 2)
        && changeAt(l, 3)
        && changeAt(l, 4)
        && changeAt(l, 5)
        && changeAt(l, 6)
        && changeAt(l, 7);
    }
    // Subscription status history (mirrors src/domain/subscription.ts), stored as ONE string
    // "YYYY-MM-DD:status;…" (1..8 entries): a single regex keeps it within the 1000-expression budget, which
    // eight price changes already nearly fill (a list of maps cost more per entry than a price change).
    // Optional: absent on every record that never changed status, so writes valid under older Rules stay
    // valid. Only for series. Increasing dates and "not in the future" are checked by the client decoder.
    function statusChanges(d) {
      return !('status_changes' in d) || (d.recurrence != null && d.status_changes is string && d.status_changes.size() <= 167
        && d.status_changes.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}:(active|paused|cancelled)(;[0-9]{4}-[0-9]{2}-[0-9]{2}:(active|paused|cancelled)){0,7}'));
    }
    // Shopping list registered by a one-off expense (mirrors src/domain/contract.ts): both fields or neither. The
    // product names are ONE string joined by '\n' (1..60 characters each, up to 100: checked by the client decoder);
    // here: size, no empty name (leading, trailing or double '\n') and no tab/CR. Absent on every other expense.
    function listLink(d) {
      return ('list_id' in d) == ('list_items' in d)
        && (!('list_id' in d) || (uuid(d.list_id) && d.recurrence == null && d.list_items is string && d.list_items.size() <= 6100
          && !d.list_items.matches('(?s)(\\n.*|.*\\n|.*\\n\\n.*|.*[\\r\\t].*)')));
    }
    function expense(d) {
      return d.keys().hasAll(['amount_minor', 'currency', 'description', 'category_id', 'expense_date', 'recurrence', 'price_changes', 'source', 'schema_version', 'created_at', 'updated_at', 'revision'])
        && d.keys().hasOnly(['amount_minor', 'currency', 'description', 'category_id', 'expense_date', 'recurrence', 'price_changes', 'status_changes', 'fund_id', 'list_id', 'list_items', 'source', 'schema_version', 'created_at', 'updated_at', 'revision'])
        && d.amount_minor is int && d.amount_minor > 0 && d.amount_minor <= 9999999
        && d.currency == 'EUR' && d.description is string && d.description.size() > 0 && d.description.size() <= 100
        && d.description == d.description.trim() && !d.description.matches('.*[\\t\\r\\n].*')
        && (d.category_id == null || uuid(d.category_id))
        // Optional like status_changes: absent = no fund, so records written under older Rules stay valid.
        && (!('fund_id' in d) || uuid(d.fund_id))
        && d.expense_date is string && validDate(d.expense_date)
        && d.recurrence in [null, 'weekly', 'monthly', 'yearly']
        && priceChanges(d.price_changes) && (d.recurrence != null || d.price_changes.size() == 0) && statusChanges(d)
        && d.source == 'web_app' && d.schema_version == 1
        && d.created_at is timestamp && d.created_at <= request.time
        && d.updated_at == request.time && d.revision is int && listLink(d);
    }
    function category(d, uid, id) {
      return d.keys().hasAll(['label', 'icon', 'name_key', 'revision', 'updated_at'])
        && d.keys().hasOnly(['label', 'icon', 'name_key', 'revision', 'updated_at'])
        && d.label is string && d.label.size() > 0 && d.label.size() <= 40 && d.label == d.label.trim()
        && !d.label.matches('.*[\\t\\r\\n].*')
        && d.icon in [null, 'cart', 'burger', 'pizza', 'pasta', 'popcorn', 'coffee', 'heart', 'star', 'gamepad', 'bag', 'box', 'house', 'bulb', 'car', 'gift', 'shirt', 'paw', 'dumbbell', 'coin', 'wallet', 'bank', 'cash', 'safe', 'growth', 'train', 'bus', 'bike', 'fuel', 'wifi', 'music', 'film', 'camera', 'graduation', 'sofa', 'beer', 'cake', 'laptop', 'piggy', 'cross', 'tree', 'sparkles', 'tv', 'utensils', 'heartpulse', 'cloud']
        && d.name_key == nameKey(d.label) && d.revision is int && d.updated_at == request.time
        && getAfter(/databases/$(database)/documents/users/$(uid)/categoryNames/$(d.name_key)).data.category_id == id;
    }
    // Fund (mirrors parseFundData in src/domain/funds.ts). Schedules are compact strings, one regex each:
    // recharges "YYYY-MM:amount:day:a|p;…", budgets and exceptions "YYYY-MM:amount;…", 0..24 entries, possibly empty.
    // Order, month ranges and "not before the start" are checked by the client decoder.
    function fund(d) {
      return d.keys().hasAll(['name', 'icon', 'color', 'initial_minor', 'start_date', 'recharges', 'budgets', 'budget_exceptions', 'archived', 'created_at', 'updated_at', 'revision'])
        && d.keys().hasOnly(['name', 'icon', 'color', 'initial_minor', 'start_date', 'recharges', 'budgets', 'budget_exceptions', 'archived', 'created_at', 'updated_at', 'revision'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40 && d.name == d.name.trim() && !d.name.matches('.*[\\t\\r\\n].*')
        && d.icon in [null, 'cart', 'burger', 'pizza', 'pasta', 'popcorn', 'coffee', 'heart', 'star', 'gamepad', 'bag', 'box', 'house', 'bulb', 'car', 'gift', 'shirt', 'paw', 'dumbbell', 'coin', 'wallet', 'bank', 'cash', 'safe', 'growth', 'train', 'bus', 'bike', 'fuel', 'wifi', 'music', 'film', 'camera', 'graduation', 'sofa', 'beer', 'cake', 'laptop', 'piggy', 'cross', 'tree', 'sparkles', 'tv', 'utensils', 'heartpulse', 'cloud']
        && d.color is int && d.color >= 0 && d.color <= 11
        && d.initial_minor is int && d.initial_minor >= 0 && d.initial_minor <= 999999999
        && d.start_date is string && validDate(d.start_date)
        && d.recharges is string && d.recharges.size() <= 600
        && d.recharges.matches('([0-9]{4}-[0-9]{2}:[0-9]{1,7}:[0-9]{1,2}:[ap](;[0-9]{4}-[0-9]{2}:[0-9]{1,7}:[0-9]{1,2}:[ap]){0,23})?')
        && d.budgets is string && d.budgets.size() <= 400
        && d.budgets.matches('([0-9]{4}-[0-9]{2}:[0-9]{1,7}(;[0-9]{4}-[0-9]{2}:[0-9]{1,7}){0,23})?')
        && d.budget_exceptions is string && d.budget_exceptions.size() <= 400
        && d.budget_exceptions.matches('([0-9]{4}-[0-9]{2}:[0-9]{1,7}(;[0-9]{4}-[0-9]{2}:[0-9]{1,7}){0,23})?')
        && d.archived is bool
        && d.created_at is timestamp && d.created_at <= request.time
        && d.updated_at == request.time && d.revision is int;
    }
    // Income (money added to to_fund_id) or transfer (from_fund_id → to_fund_id, one atomic document). Immutable.
    function movement(d) {
      return d.keys().hasAll(['kind', 'amount_minor', 'date', 'to_fund_id', 'from_fund_id', 'note', 'created_at'])
        && d.keys().hasOnly(['kind', 'amount_minor', 'date', 'to_fund_id', 'from_fund_id', 'note', 'created_at'])
        && d.kind in ['income', 'transfer']
        && d.amount_minor is int && d.amount_minor > 0 && d.amount_minor <= 999999999
        && d.date is string && validDate(d.date)
        && uuid(d.to_fund_id)
        && (d.kind == 'income' ? d.from_fund_id == null : uuid(d.from_fund_id) && d.from_fund_id != d.to_fund_id)
        && d.note is string && d.note.size() <= 100 && d.note == d.note.trim() && !d.note.matches('.*[\\t\\r\\n].*')
        && d.created_at is timestamp && d.created_at <= request.time;
    }
    // Shopping list (mirrors parseListData in src/domain/shoppingList.ts). Last write wins: no revision. expense_id is set
    // by the registration transaction together with the expense, and cleared when that expense is deleted.
    function shoppingList(d) {
      return d.keys().hasAll(['name', 'category_id', 'total_minor', 'expense_id', 'created_at', 'updated_at'])
        && d.keys().hasOnly(['name', 'category_id', 'total_minor', 'expense_id', 'created_at', 'updated_at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40 && d.name == d.name.trim() && !d.name.matches('.*[\\t\\r\\n].*')
        && (d.category_id == null || uuid(d.category_id))
        && (d.total_minor == null || (d.total_minor is int && d.total_minor > 0 && d.total_minor <= 9999999))
        && (d.expense_id == null || uuid(d.expense_id))
        && d.created_at is timestamp && d.created_at <= request.time && d.updated_at == request.time;
    }
    // Product of a list: one small document, so ticking it is a single write the SDK can queue offline.
    function listItem(d) {
      return d.keys().hasAll(['list_id', 'name', 'checked', 'position']) && d.keys().hasOnly(['list_id', 'name', 'checked', 'position'])
        && uuid(d.list_id)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60 && d.name == d.name.trim() && !d.name.matches('.*[\\t\\r\\n].*')
        && d.checked is bool && d.position is int && d.position >= 0 && d.position <= 999999999;
    }
    match /config/owner {
      allow get: if request.auth != null && owner(request.auth.uid);
      allow write, list: if false;
    }
    match /users/{uid}/expenses/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && uuid(id) && expense(request.resource.data) && request.resource.data.revision == 1;
      allow update: if owner(uid) && expense(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner(uid);
    }
    match /users/{uid}/categories/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && uuid(id) && category(request.resource.data, uid, id) && request.resource.data.revision == 1;
      allow update: if owner(uid) && category(request.resource.data, uid, id)
        && request.resource.data.revision == resource.data.revision + 1
        && (request.resource.data.name_key == resource.data.name_key
          || !existsAfter(/databases/$(database)/documents/users/$(uid)/categoryNames/$(resource.data.name_key)));
      allow delete: if owner(uid) && !existsAfter(/databases/$(database)/documents/users/$(uid)/categoryNames/$(resource.data.name_key));
    }
    match /users/{uid}/funds/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && uuid(id) && fund(request.resource.data) && request.resource.data.revision == 1;
      allow update: if owner(uid) && fund(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.start_date == resource.data.start_date
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner(uid);
    }
    match /users/{uid}/movements/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && uuid(id) && movement(request.resource.data);
      allow update: if false;
      allow delete: if owner(uid);
    }
    match /users/{uid}/lists/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && uuid(id) && shoppingList(request.resource.data);
      allow update: if owner(uid) && shoppingList(request.resource.data) && request.resource.data.created_at == resource.data.created_at;
      allow delete: if owner(uid);
    }
    match /users/{uid}/listItems/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && uuid(id) && listItem(request.resource.data);
      allow update: if owner(uid) && listItem(request.resource.data) && request.resource.data.list_id == resource.data.list_id;
      allow delete: if owner(uid);
    }
    match /users/{uid}/categoryNames/{key} {
      allow read: if owner(uid);
      function validLock() {
        return request.resource.data.keys().hasOnly(['category_id']) && uuid(request.resource.data.category_id)
          && getAfter(/databases/$(database)/documents/users/$(uid)/categories/$(request.resource.data.category_id)).data.name_key == key;
      }
      allow create: if owner(uid) && validLock();
      allow update: if owner(uid) && validLock() && resource.data.category_id == request.resource.data.category_id;
      allow delete: if owner(uid) && (!existsAfter(/databases/$(database)/documents/users/$(uid)/categories/$(resource.data.category_id))
        || getAfter(/databases/$(database)/documents/users/$(uid)/categories/$(resource.data.category_id)).data.name_key != key);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
